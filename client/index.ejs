<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Hypersight</title>
    <meta charset="utf-8">
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0"
    >
    <meta http-equiv="Cache-control" content="no-cache">
  </head>
  <body>
    <% if (htmlWebpackPlugin.options.devLiveReload) { %>
      <script>
        (function () {
          if (typeof EventSource === 'undefined') return

          window.__HYPERSIGHT_DEV_RELOAD__ = {
            connectedAt: Date.now(),
          }

          var source = new EventSource('/__dev_reload')
          source.addEventListener('reload', function () {
            window.location.reload()
          })
        }())
      </script>
    <% } %>
    <noscript>
      <div class="noscript-error">
        <div class="main">
          <p class="you-must">Hypersight real-time public-data visualizer for Hyperliquid trades.</p>
        </div>
      </div>
    </noscript>
  </body>
</html>
